# Epic Games Status API — Environment Variables
# Copy to .env and customize. All variables are optional (sane defaults provided).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
WORKERS=1

# ── Caching (seconds) ─────────────────────────────────────────────────────────
CACHE_TTL_STATUS=30
CACHE_TTL_COMPONENTS=30
CACHE_TTL_INCIDENTS=60
CACHE_TTL_EAC=30
CACHE_TTL_FREE_GAMES=300
CACHE_TTL_UPSTREAM=60

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_DASHBOARD=60/minute

# ── HTTP client ───────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=12.0
USER_AGENT=Mozilla/5.0 (compatible; EpicGamesStatusAPI/1.0; +https://github.com/ynwglobal/epic-games-status-monitor)

# ── CORS (comma-separated origins, * = all) ───────────────────────────────────
# CORS_ORIGINS=["*"]
# CORS_ORIGINS=["https://your-frontend.com","https://another-frontend.com"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=data/history.db
